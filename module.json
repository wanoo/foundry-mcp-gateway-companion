{
  "id": "foundry-mcp-gateway-companion",
  "title": "Foundry MCP Companion",
  "description": "Browser-side companion for the foundry-mcp-gateway MCP server. The gateway talks to Foundry over the socket protocol, which only reaches documents; this module runs in the Gamemaster's browser and executes what the socket cannot: read prepared sheet values, screenshot the canvas, ask a player a question and get their answer, run macros, roll with the real system engine and Dice So Nice, drive weather and effects. Install it and your MCP client gains 36 client_* tools. Optional — without it, everything else still works.",
  "version": "1.5.1",
  "authors": [
    {
      "name": "wanoo",
      "url": "https://github.com/wanoo"
    }
  ],
  "compatibility": {
    "minimum": "12",
    "verified": "13"
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    }
  ],
  "relationships": {
    "recommends": [
      {
        "id": "dice-so-nice",
        "type": "module",
        "reason": "3D dice for rolls triggered through the gateway"
      },
      {
        "id": "sequencer",
        "type": "module",
        "reason": "visual effects: client_play_effect, client_seq_between"
      },
      {
        "id": "fxmaster",
        "type": "module",
        "reason": "scene weather: client_weather"
      },
      {
        "id": "tokenmagic",
        "type": "module",
        "reason": "token filters: client_token_fx"
      },
      {
        "id": "campaign-codex",
        "type": "module",
        "reason": "campaign sheets: client_cc_* tools"
      },
      {
        "id": "monks-active-tiles",
        "type": "module",
        "reason": "trigger active tiles: client_mat_trigger"
      },
      {
        "id": "babele",
        "type": "module",
        "reason": "translated compendium view: client_babele"
      }
    ]
  },
  "socket": true,
  "url": "https://github.com/wanoo/foundry-mcp-gateway-companion",
